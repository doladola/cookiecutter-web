MANAGE_PY_PATH=manage.py
# Docker image version
VERSION=0.1.0
# django secret key, generate your own using `python -c "import secrets; print(secrets.token_urlsafe())"`
SECRET_KEY=replace-with-your-secret-key
DEBUG=True
# set allowed hosts, comma separated, e.g. localhost,example.com
ALLOWED_HOSTS=localhost,127.0.0.1
# set force script name if your app is served under a subpath, e.g. /mysite
FORCE_SCRIPT_NAME=/mysite
# CSRF trusted origins, comma separated, e.g. http://localhost:8000,https://example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# log level
LOGGER_LEVEL=INFO
{% if cookiecutter.use_async %}
# async deployment settings
GUNICORN_WORKERS=4
UVICORN_WORKERS=4
{% else %}
# sync deployment settings
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
{% endif %}
{% if cookiecutter.project_type in ['standard','advanced'] %}
# database settings
DB_NAME={{ cookiecutter.project }}
DB_USER={{ cookiecutter.project }}
DB_PASSWORD={{ cookiecutter.project }}
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
# redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
# supper user setting
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=your.email@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-your-password
{% endif %}
{% if cookiecutter.project_type == 'advanced' %}
# celery settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
{% endif %}
{% if cookiecutter.use_sentry %}
# sentry settings
SENTRY_DSN=replace-with-your-dsn-url
SENTRY_LOG=True
SENTRY_TRACES_SAMPLE_RATE=0.01
SENTRY_PROFILE=trace
{% endif %}
